{
  "opencollection": "1.0.0",
  "info": {
    "name": "Radar Addresses Events API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List events.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.radar.io/v1/events",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of events (default 100, max 1000)."
              }
            ]
          },
          "docs": "Lists geofence, place, and trip events, sorted by creation date descending."
        },
        {
          "info": {
            "name": "Get an event.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.radar.io/v1/events/:eventId",
            "params": [
              {
                "name": "eventId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves an event by ID."
        }
      ]
    }
  ],
  "bundled": true
}