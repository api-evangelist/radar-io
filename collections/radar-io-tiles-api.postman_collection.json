          "name": "Get a raster map tile.",
          "request": {
            "name": "Get a raster map tile.",
            "description": {
              "content": "Returns a raster (PNG) map tile for the given zoom, x, and y coordinates.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "maps",
                "tiles",
                ":z",
                ":x",
                "{{y}}.png"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "style",
                  "value": "radar-default-v1",
                  "description": "The map style (e.g. radar-default-v1, radar-light-v1, radar-dark-v1)."
                },
                {
                  "disabled": false,
                  "key": "scale",
                  "value": "1",
                  "description": "The tile scale (1 or 2 for retina)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "z",
                  "description": "(Required) The zoom level."
